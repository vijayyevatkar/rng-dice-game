# ==============================================================================
# MacBook Pro 14" (M5 / M6) Deal Monitor Configuration
# Copy to .env and fill in at least ONE notification channel!
# ==============================================================================

# --- 1. INSTANT NOTIFICATIONS (pick 1 or more; ntfy.sh needs zero signup!) ---
# Create any secret topic name (e.g. mbp-austin-9x4k2), install the ntfy app on
# iPhone/Android or subscribe at https://ntfy.sh/<topic>
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Discord Webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=

# Telegram Bot (create via @BotFather, get chat ID via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# macOS Studio local alert (native notification banner + sound chime)
MACOS_NOTIFY=true
MACOS_SOUND=Hero

# --- 2. OPTIONAL API KEYS (drastically improves Best Buy & Amazon coverage) ---
# Free Best Buy Developer API key: https://developer.bestbuy.com/
# Unlocks official Open Box + local store stock API with zero scraping blocks
BESTBUY_API_KEY=

# Optional Keepa API key: https://keepa.com/#!api (for sub-minute Amazon Resale/New)
KEEPA_API_KEY=

# --- 3. LOCATION & PRICING OPTIMIZATION ---
ZIP_CODE=78759
# Set true if you have a B&H Payboo card (calculates ~8.25% TX tax instant rebate)
HAS_BH_PAYBOO=false
# Set true if you have Costco Executive + Costco Visa (calculates 4% cashback)
HAS_COSTCO_4PCT=false
# Sales tax rate for Austin TX (used for Payboo effective-price comparison)
TAX_RATE=0.0825

# --- 4. POLLING CADENCE (seconds) ---
FAST_INTERVAL_SEC=60
BROWSER_INTERVAL_SEC=180
# Minimum dollar drop required to re-alert on the same listing/SKU
REALERT_DROP_DOLLARS=15
# Hours before re-alerting the exact same unchanged deal
ALERT_COOLDOWN_HOURS=12

# --- 5. PLAYWRIGHT BROWSER TIER ---
ENABLE_BROWSER_MONITORS=true
BROWSER_HEADLESS=true
